{
  "name": "turkiye-isletme-araclari",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@tia/web",
    "build": "npm run build --workspace=@tia/web",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspace=@tia/web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
